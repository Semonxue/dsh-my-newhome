{
  "name": "dsh-my-newhome",
  "version": "0.4.0",
  "private": true,
  "description": "Custom homepage for DeepSeek Harness: palette, background image, active-workspace cards, quick links, API-usage widgets, custom logo · 自定义主页",
  "repository": {
    "type": "git",
    "url": "https://github.com/Semonxue/dsh-my-newhome.git"
  },
  "homepage": "https://github.com/Semonxue/dsh-my-newhome#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "homepage",
    "theme"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "test",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  }
}
